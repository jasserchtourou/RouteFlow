# Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
BUSINESS_TIMEZONE=Europe/Berlin    # defines "today" for dashboard metrics
YARD_SIMULATION_ENABLED=true       # keep a rolling schedule of truck visits for the 3D site view

# --- PostgreSQL ---
POSTGRES_USER=routeflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=routeflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
BACKEND_PORT=8000              # host port of the dockerized backend
FRONTEND_PORT=3000             # host port of the dockerized frontend
# Async SQLAlchemy URL used by the backend
DATABASE_URL=postgresql+asyncpg://routeflow:change-me@localhost:5432/routeflow
# Separate database for automated tests
TEST_DATABASE_URL=postgresql+asyncpg://routeflow:change-me@localhost:5432/routeflow_test

# --- AI (used from Phase 13/14) ---
LLM_PROVIDER=ollama            # ollama | openai | anthropic | ...
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
LLM_API_KEY=                   # only for hosted providers

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- Frontend (used from Phase 9) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Dev tooling (optional) ---
# 21st.dev Magic MCP key for UI component generation; get one at https://21st.dev/mcp
# Set it in your shell/OS environment (it is referenced from .mcp.json), not in committed files.
API_KEY_21ST=
